// Model danych Neto (SPEC sekcja 8). Plik wspólny: zmienia go tylko sesja koordynująca.
// Kwoty: Decimal(20,4). Ilości i kursy: Decimal(28,10). Dni wyceny: @db.Date (data w strefie Europe/Warsaw).
// Każdy model z danymi użytkownika ma userId bezpośrednio albo przez FinancialAccount; dostęp tylko przez src/lib/db/scoped.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Użytkownik i bezpieczeństwo (Etap 4) ----------

enum Locale {
  pl
  en
}

enum Theme {
  system
  light
  dark
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  emailVerified       DateTime?
  passwordHash        String?
  name                String?
  image               String?
  birthYear           Int?
  locale              Locale    @default(pl)
  baseCurrency        String    @default("PLN") @db.Char(3)
  timezone            String    @default("Europe/Warsaw")
  theme               Theme     @default(system)
  privacyMode         Boolean   @default(false)
  totpSecretEnc       String?
  totpEnabledAt       DateTime?
  deletionRequestedAt DateTime?
  termsAcceptedAt     DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  backupCodes        BackupCode[]
  auditLogs          AuditLog[]
  financialAccounts  FinancialAccount[]
  assets             Asset[]
  importBatches      ImportBatch[]
  importMappings     ImportMapping[]
  portfolioSnapshots PortfolioSnapshot[]
  recalcJobs         RecalcJob[]
  goals              Goal[]
  retirementPlan     RetirementPlan?
  notifications      Notification[]
  notificationPrefs  NotificationPref[]
  pushDevices        PushDevice[]
}

/// Konta OAuth (Auth.js), np. Google. Nie mylić z FinancialAccount.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

enum Platform {
  web
  ios
}

model Session {
  id                String   @id @default(cuid())
  sessionToken      String   @unique
  userId            String
  expires           DateTime
  /// Sesja po haśle czeka na kod 2FA, zanim da dostęp do danych.
  twoFactorVerified Boolean  @default(false)
  userAgent         String?
  /// Skrócony adres IP (bez ostatniego oktetu / ostatnich 80 bitów).
  ipPrefix          String?
  platform          Platform @default(web)
  lastSeenAt        DateTime @default(now())
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Limity prób (logowanie, rejestracja, reset): stałe okno czasowe na klucz, np. "login:email:<hash>".
model RateLimit {
  key         String   @id
  windowStart DateTime
  count       Int
}

model BackupCode {
  id       String    @id @default(cuid())
  userId   String
  codeHash String
  usedAt   DateTime?
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  /// Zostaje po usunięciu użytkownika (SetNull) jako ślad zdarzeń bezpieczeństwa.
  userId    String?
  event     String
  ipPrefix  String?
  userAgent String?
  meta      Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

// ---------- Konta finansowe, aktywa, pozycje (Etap 5) ----------

enum AccountKind {
  ASSET
  LIABILITY
}

enum AccountType {
  CASH
  CHECKING
  SAVINGS
  DEPOSIT
  BROKERAGE
  RETIREMENT
  CRYPTO
  RETAIL_BONDS
  REAL_ESTATE
  VEHICLE
  OTHER_ASSET
  MORTGAGE
  LOAN
  LEASE
  CREDIT_CARD
  OTHER_LIABILITY
}

enum TaxWrapper {
  NONE
  IKE
  IKZE
  PPK
  OIPE
}

model FinancialAccount {
  id                String      @id @default(cuid())
  userId            String
  name              String
  kind              AccountKind
  type              AccountType
  currency          String      @db.Char(3)
  institution       String?
  taxWrapper        TaxWrapper  @default(NONE)
  ownershipShare    Decimal     @default(1) @db.Decimal(5, 4)
  includeInNetWorth Boolean     @default(true)
  notesEnc          String?
  accountNumberEnc  String?
  sortOrder         Int         @default(0)
  archivedAt        DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  liability      Liability?
  deposit        Deposit?      @relation("DepositAccount")
  depositPayouts Deposit[]     @relation("DepositPayout")
  holdings       Holding[]
  transactions   Transaction[]
  goalAccounts   GoalAccount[]

  @@index([userId, archivedAt])
}

model Liability {
  accountId      String           @id
  interestRate   Decimal?         @db.Decimal(9, 6)
  monthlyPayment Decimal?         @db.Decimal(20, 4)
  endDate        DateTime?        @db.Date
  originalAmount Decimal?         @db.Decimal(20, 4)
  account        FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

enum Capitalization {
  END
  MONTHLY
  QUARTERLY
  ANNUAL
}

model Deposit {
  accountId       String            @id
  principal       Decimal           @db.Decimal(20, 4)
  /// Oprocentowanie roczne nominalne jako ułamek (0.051 = 5,1%).
  rate            Decimal           @db.Decimal(9, 6)
  startDate       DateTime          @db.Date
  termMonths      Int
  capitalization  Capitalization
  autoRenew       Boolean           @default(false)
  payoutAccountId String?
  account         FinancialAccount  @relation("DepositAccount", fields: [accountId], references: [id], onDelete: Cascade)
  payoutAccount   FinancialAccount? @relation("DepositPayout", fields: [payoutAccountId], references: [id], onDelete: SetNull)
}

enum AssetClass {
  EQUITY
  ETF
  FUND
  BOND
  RETAIL_BOND
  CRYPTO
  COMMODITY
  OTHER
}

enum PriceSource {
  PROVIDER
  MANUAL
}

/// Instrument. userId = null: katalog wspólny (tylko do odczytu dla użytkowników); inaczej instrument własny użytkownika.
model Asset {
  id          String      @id @default(cuid())
  userId      String?
  name        String
  symbol      String?
  isin        String?
  /// Kod rynku MIC, np. XWAR, XETR.
  exchange    String?
  assetClass  AssetClass
  currency    String      @db.Char(3)
  priceSource PriceSource @default(MANUAL)
  providerRef String?
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())

  user             User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  retailBondSeries RetailBondSeries?
  holdings         Holding[]
  transactions     Transaction[]
  prices           PriceSnapshot[]

  @@index([symbol])
  @@index([isin])
  @@index([userId])
}

enum RetailBondType {
  OTS
  ROR
  DOR
  TOS
  COI
  EDO
  ROS
  ROD
}

model RetailBondSeries {
  assetId     String         @id
  bondType    RetailBondType
  /// Pierwszy dzień miesiąca emisji.
  issueMonth  DateTime       @db.Date
  /// [{ "from": "YYYY-MM-DD", "rate": "0.0675" }] — oprocentowanie kolejnych okresów.
  periodRates Json
  asset       Asset          @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

/// Pamięć podręczna pozycji przeliczana z transakcji; źródłem prawdy są Transaction i Lot.
model Holding {
  id            String   @id @default(cuid())
  accountId     String
  assetId       String
  quantity      Decimal  @db.Decimal(28, 10)
  costBasis     Decimal  @db.Decimal(20, 4)
  costBasisBase Decimal  @db.Decimal(20, 4)
  updatedAt     DateTime @updatedAt

  account FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  asset   Asset            @relation(fields: [assetId], references: [id], onDelete: Restrict)
  lots    Lot[]

  @@unique([accountId, assetId])
}

model Lot {
  id        String   @id @default(cuid())
  holdingId String
  openedAt  DateTime @db.Date
  quantity  Decimal  @db.Decimal(28, 10)
  remaining Decimal  @db.Decimal(28, 10)
  unitCost  Decimal  @db.Decimal(28, 10)
  /// Kurs waluty instrumentu do PLN z dnia zakupu.
  fxRate    Decimal  @db.Decimal(28, 10)
  holding   Holding  @relation(fields: [holdingId], references: [id], onDelete: Cascade)

  @@index([holdingId, openedAt])
}

enum TransactionType {
  BUY
  SELL
  DEPOSIT
  WITHDRAWAL
  DIVIDEND
  INTEREST
  FEE
  TAX
  TRANSFER_IN
  TRANSFER_OUT
  VALUATION
  BALANCE_SET
}

model Transaction {
  id              String          @id @default(cuid())
  accountId       String
  assetId         String?
  type            TransactionType
  date            DateTime        @db.Date
  quantity        Decimal?        @db.Decimal(28, 10)
  price           Decimal?        @db.Decimal(28, 10)
  amount          Decimal         @db.Decimal(20, 4)
  currency        String          @db.Char(3)
  fxRate          Decimal?        @db.Decimal(28, 10)
  fee             Decimal?        @db.Decimal(20, 4)
  note            String?
  /// Łączy obie strony przelewu między kontami.
  transferGroupId String?
  importBatchId   String?
  /// Odcisk wiersza importu do wykrywania duplikatów.
  fingerprint     String?
  /// Wynik zrealizowany przy sprzedaży (PLN), zapisany w chwili transakcji.
  realizedPnlBase Decimal?        @db.Decimal(20, 4)
  createdAt       DateTime        @default(now())

  account     FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  asset       Asset?           @relation(fields: [assetId], references: [id], onDelete: Restrict)
  importBatch ImportBatch?     @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  @@index([accountId, date])
  @@index([assetId])
  @@index([importBatchId])
  @@index([accountId, fingerprint])
}

enum ImportStatus {
  PREVIEW
  IMPORTED
  REVERTED
  FAILED
}

model ImportBatch {
  id         String       @id @default(cuid())
  userId     String
  fileName   String
  source     String?
  mapping    Json
  rows       Int
  imported   Int          @default(0)
  skipped    Int          @default(0)
  status     ImportStatus @default(PREVIEW)
  createdAt  DateTime     @default(now())
  revertedAt DateTime?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId, createdAt])
}

model ImportMapping {
  id      String @id @default(cuid())
  userId  String
  source  String
  mapping Json
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source])
}

// ---------- Ceny i wycena (Etap 6) ----------

model PriceSnapshot {
  assetId   String
  date      DateTime @db.Date
  close     Decimal  @db.Decimal(28, 10)
  currency  String   @db.Char(3)
  source    String
  fetchedAt DateTime @default(now())
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([assetId, date])
  @@index([assetId, date(sort: Desc)])
}

enum FxTable {
  A
  B
  MANUAL
}

model FxRate {
  date     DateTime @db.Date
  currency String   @db.Char(3)
  /// Ile PLN za 1 jednostkę waluty.
  ratePln  Decimal  @db.Decimal(28, 10)
  table    FxTable
  source   String

  @@id([date, currency])
  @@index([currency, date(sort: Desc)])
}

model PortfolioSnapshot {
  userId      String
  date        DateTime @db.Date
  assets      Decimal  @db.Decimal(20, 4)
  liabilities Decimal  @db.Decimal(20, 4)
  netWorth    Decimal  @db.Decimal(20, 4)
  byClass     Json
  byCurrency  Json
  byAccount   Json
  staleCount  Int      @default(0)
  computedAt  DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, date])
  @@index([userId, date(sort: Desc)])
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

model RecalcJob {
  id        String    @id @default(cuid())
  userId    String
  fromDate  DateTime  @db.Date
  status    JobStatus @default(PENDING)
  attempts  Int       @default(0)
  lastError String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId])
}

// ---------- Cele (Etap 8) ----------

enum GoalKind {
  SAVINGS
  NET_WORTH
  RETIREMENT
}

model Goal {
  id           String    @id @default(cuid())
  userId       String
  name         String
  kind         GoalKind
  targetAmount Decimal   @db.Decimal(20, 4)
  currency     String    @default("PLN") @db.Char(3)
  targetDate   DateTime? @db.Date
  /// Cel „od zera”: kwota odłożona poza kontami w aplikacji (wpisywana ręcznie). Przy kontach lub wartości netto pusta.
  savedAmount  Decimal?  @db.Decimal(20, 4)
  isMain       Boolean   @default(false)
  achievedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts GoalAccount[]

  @@index([userId])
}

model GoalAccount {
  goalId    String
  accountId String
  goal      Goal             @relation(fields: [goalId], references: [id], onDelete: Cascade)
  account   FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([goalId, accountId])
}

model RetirementPlan {
  userId              String  @id
  retireAge           Int     @default(65)
  monthlyContribution Decimal @db.Decimal(20, 4)
  monthlySpending     Decimal @db.Decimal(20, 4)
  zusMonthly          Decimal @default(0) @db.Decimal(20, 4)
  withdrawalRate      Decimal @default(0.04) @db.Decimal(9, 6)
  returnLow           Decimal @default(0.01) @db.Decimal(9, 6)
  returnBase          Decimal @default(0.03) @db.Decimal(9, 6)
  returnHigh          Decimal @default(0.05) @db.Decimal(9, 6)
  inflation           Decimal @default(0.03) @db.Decimal(9, 6)
  includeHome         Boolean @default(false)
  user                User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- Powiadomienia (Etap 9) ----------

enum NotificationType {
  WEEKLY_SUMMARY
  GOAL_ACHIEVED
  STALE_VALUATION
  SECURITY
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model NotificationPref {
  userId  String
  type    NotificationType
  channel NotificationChannel
  enabled Boolean
  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, type, channel])
}

model PushDevice {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  platform   Platform @default(ios)
  appVersion String?
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

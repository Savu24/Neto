# Wzór zmiennych środowiskowych (SPEC sekcja 15). Skopiuj do .env.local i uzupełnij lokalnie.
# Prawdziwe sekrety ustawia właściciel w Vercelu/Codemagic. Nigdy nie wpisuj produkcyjnych wartości do repo.
# Brak klucza = funkcja wyłączona (flagi w src/env.ts).

APP_URL=http://localhost:3000

# Etap 3: lokalna baza (npm run db:start). Nigdy produkcyjna.
DATABASE_URL=

# Etap 4
AUTH_SECRET=
FIELD_ENCRYPTION_KEY=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
BOT_PROTECTION_SITE_KEY=
BOT_PROTECTION_SECRET=
PWNED_PASSWORDS_CHECK=false

# Etap 6 i 9
PRICING_PROVIDER=
PRICING_API_KEY=
EMAIL_PROVIDER_KEY=
EMAIL_FROM=
FCM_SERVICE_ACCOUNT=
CRON_SECRET=
SENTRY_DSN=

# Tylko lokalnie/e2e: e-maile do plików zamiast wysyłki (bez dostawcy)
MAIL_OUTBOX_DIR=
